# Copia este archivo como .env.local para desarrollo. NUNCA subas .env a Git.
# En Netlify se configuran en: Site configuration → Environment variables.

# --- Navegador (públicas por diseño, protegidas por RLS) ---
# Supabase → Project Settings → API → Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Solo servidor (Netlify Functions). Jamás con prefijo VITE_ ---
# Activa el botón "Leer con IA". Déjala vacía para usar solo la lectura local.
ANTHROPIC_API_KEY=
# Las mismas de arriba, para que la función verifique la sesión del usuario.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Límite de lecturas con IA por usuario (por hora)
AI_LIMIT_PER_HOUR=40

# Avisos al teléfono (se generan en el panel: Más → Avisos en este teléfono). Solo en Netlify.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
AVISOS_SECRET=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
